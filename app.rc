// app.rc —— 应用程序资源
#include <windows.h>

// 主图标（多尺寸 ICO）
IDI_APPICON ICON "Zerin.ico"

// 版本信息
VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "Zerin-emm"
            VALUE "FileDescription",  "NVIDIA GPU RGB lighting controller"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "GpuColorLite"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "GpuColorLite.exe"
            VALUE "ProductName",      "GpuColorLite"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
